# supabase secrets set --env-file backend/supabase/.env
FACEIT_API_KEY=your-faceit-server-side-api-key
# Comma-separated extension origins allowed to call the proxy (recommended once published):
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop,moz-extension://*
RATE_LIMIT_PER_MINUTE=120
