{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "types": ["chrome", "vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@ext/*": ["extension/*"],
      "@dash/*": ["dashboard/*"]
    }
  },
  "include": ["shared", "extension", "dashboard", "tests", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "backend"]
}
